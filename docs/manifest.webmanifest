{
  "name": "CorrectMe",
  "short_name": "CorrectMe",
  "description": "AI speaking coach: read polished replies aloud and get pronunciation feedback.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f766e",
