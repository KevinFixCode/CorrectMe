# Copy this file to .env and edit. Never commit .env (it is in .gitignore).

# --- Language model (writes the replies) ---
# ollama    : free, runs locally (install from ollama.com, then `ollama pull llama3.1`)
# openai    : any OpenAI-compatible API (set LLM_BASE_URL for OpenRouter, LM Studio, ...)
# anthropic : Claude API
LLM_PROVIDER=ollama
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# --- Speech-to-text (Whisper, runs locally) ---
# tiny / base / small / medium / large-v3. Bigger = more accurate but slower.
WHISPER_MODEL=small
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8

# --- Learning ---
# Language used for word meanings
NATIVE_LANGUAGE=Indonesian
# B1, B2, C1 or C2 (C2 = IELTS band 9 style)
CORRECTME_LEVEL=C2
# CORRECTME_DB=~/.correctme/vocab.db
